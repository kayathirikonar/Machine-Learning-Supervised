      "source": [
        "# **Train-Test Split**"
      ],
      "metadata": {
        "id": "11TrEj8jHGOM"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Imports the function to split the dataset into training and testing sets\n",
        "from sklearn.model_selection import train_test_split"
      ],
      "metadata": {
        "id": "iAO79t-r9E_p"
      },
      "execution_count": 41,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Splits the data into training and testing sets (80% train, 20% test) using a fixed random seed\n",
        "x_train, x_test, y_train, y_test = train_test_split(x, y, test_size = 0.2, random_state = 42)"
      ],
      "metadata": {
        "id": "SdwYnunL9aep"
