      "source": [
        "# **Logistic Regression Model**"
      ],
      "metadata": {
        "id": "nIWYeyhKHMO3"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Imports the LogisticRegression model from scikit-learn for binary classification\n",
        "from sklearn.linear_model import LogisticRegression"
      ],
      "metadata": {
        "id": "XRNxECEk9nix"
      },
      "execution_count": 45,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Creates an instance of the LogisticRegression model with default parameters\n",
        "logmodel = LogisticRegression()"
      ],
      "metadata": {
        "id": "WpGa63Zg90Vs"
      },
      "execution_count": 46,
      "outputs": []
    },
    {
